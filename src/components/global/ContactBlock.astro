---
// "Ready to Transform" contact block (AI Studio) wrapping our tabbed LeadForm (Request a Quote / Book a Time).
import LeadForm from '../LeadForm.astro';
import { BUSINESS } from '../../data/business.mjs';
interface Props { slug?: string; city?: string; source?: string }
const { slug = '', city = 'Conway', source = 'contact_block' } = Astro.props;
---
<section class="ui cb" id="contact" aria-labelledby="cb-h">
  <div class="wrap cb-grid">
    <div>
      <span class="pill">Get Started Today</span>
      <h2 id="cb-h">Ready to <em>Transform</em> Your Bathroom?</h2>
      <p class="lead">Request your free, no-obligation in-home estimate or pick a time on our calendar. Our Central Arkansas remodeling specialists confirm by call or text.</p>
      <ul>
        <li><a href={`tel:${BUSINESS.tel}`} data-contact="call"><span class="ic"><span class="ms" aria-hidden="true">call</span></span><span><strong>Call Our Experts</strong><span>{BUSINESS.phone}</span><small>Tap to dial</small></span></a></li>
        <li><a href={`sms:${BUSINESS.tel}`} data-contact="sms"><span class="ic"><span class="ms" aria-hidden="true">sms</span></span><span><strong>Text / SMS Support</strong><span>{BUSINESS.phone}</span><small>Fast mobile response</small></span></a></li>
        <li><a href={`mailto:${BUSINESS.email}`}><span class="ic"><span class="ms" aria-hidden="true">mail</span></span><span><strong>Email Office</strong><span>{BUSINESS.email}</span><small>Replies within one business day</small></span></a></li>
        <li><div><span class="ic"><span class="ms" aria-hidden="true">location_on</span></span><span><strong>Central Arkansas Service Area</strong><span>Conway HQ · 50-mile radius</span><small>Mon–Fri 7:30–5 · Sat 7–7 · Sun 9–3</small></span></div></li>
      </ul>
    </div>
    <div><LeadForm variant="full" pitch={false} bare={true} slug={slug} city={city} source={source} /></div>
  </div>
</section>
