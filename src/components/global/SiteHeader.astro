---
// AI Studio-style global header. Native <details> menus (links stay plain <a href> in the HTML);
// a tiny script adds hover-open on desktop, one-open-at-a-time, Esc and click-outside close.
import { CATEGORIES } from '../../data/services.mjs';
import { CITIES } from '../../data/cities.mjs';
import { BUSINESS } from '../../data/business.mjs';
interface Props { current?: string }
const { current = '' } = Astro.props;
const TOP = ['conway','little-rock','north-little-rock','maumelle','cabot','benton'].map((x) => CITIES.find((c) => c.slug === x)).filter(Boolean);
// One dropdown per service category (AI Studio-style), plus areas, financing, reviews, company.
// Header = most important pages only; legal, docs, small towns and full city lists stay in the footer.
const cat = (slug: string, overview: string, extra: [string, string][] = []) => {
  const c = CATEGORIES.find((x) => x.slug === slug)!;
  return [[`/${c.slug}`, overview, true], ...extra.map(([h, n]) => [h, n, false]), ...c.subs.filter((s) => s.slug !== 'full-bathroom-remodel').map((s) => [`/${c.slug}/${s.slug}`, s.name, false])];
};
type Item = [string, string, boolean];
const MENU: { label: string; href?: string; match: string[]; items?: Item[]; sub?: boolean; right?: boolean }[] = [
  { label: 'Bathroom', match: ['bathroom-remodeling'], sub: true, items: cat('bathroom-remodeling', 'Bathroom Remodeling Overview') as Item[] },
  { label: 'Kitchen', match: ['kitchen-remodeling'], sub: true, items: cat('kitchen-remodeling', 'Kitchen Remodeling Overview') as Item[] },
  { label: 'Handyman', match: ['handyman-services'], sub: true, items: cat('handyman-services', 'Handyman & 24/7 Emergency Service') as Item[] },
  { label: 'Service Areas', match: ['service-areas'], items: [...TOP.map((c) => [`/service-areas/${c!.slug}`, `${c!.name}, AR`, false]), ['/service-areas', 'All service areas & map →', true]] as Item[] },
  { label: 'Financing', match: ['financing', 'services-pricing', 'warranty'], items: [['/financing', 'Financing & Payment Options', true], ['/services-pricing', 'Pricing & Shower Packages', false], ['/warranty', 'Warranty & Guarantee', false]] },
  { label: 'Reviews', href: '/reviews', match: ['reviews'] },
  { label: 'Company', match: ['about', 'portfolio', 'guides', 'contact', 'blog', 'planning-checklist'], right: true, items: [['/about', 'About Us', false], ['/portfolio', 'Project Gallery', false], ['/guides', 'Guides & Costs', false], ['/planning-checklist', 'Bathroom Planning Checklist', false], ['/contact', 'Contact Us', false]] },
];
const Q = 'https://client.swivl.tech/all-star-renovate-318dbc/instant-quote?widget=instant-quote';
const cur = (p: string) => (current === p || current.startsWith(p + '/')) ? 'page' : undefined;
---
<header class="ui sh">
  <div class="wrap sh-in">
    <a class="sh-brand" href="/">
      <img src="/icon-192.png" alt="" width="44" height="44" />
      <span><b>ALL-STAR RENOVATIONS</b><small>Central Arkansas · Conway</small></span>
    </a>
    <nav class="sh-nav" aria-label="Primary">
      {MENU.map((m) => m.items ? (
        <details class:list={['sh-dd', m.right && 'sh-dd-r']}>
          <summary aria-current={m.match.some((x) => cur(x)) ? 'page' : undefined}>{m.label}<span class="ms" aria-hidden="true">expand_more</span></summary>
          <div class="sh-menu">
            {m.items.map(([h, n, top]) => <a href={h} aria-current={current && h === `/${current}` ? 'page' : undefined}>{top ? <strong>{n}</strong> : n}</a>)}
          </div>
        </details>
      ) : <a href={m.href} aria-current={cur(m.match[0])}>{m.label}</a>)}
    </nav>
    <div class="sh-ctas">
      <a class="sh-call" href={`tel:${BUSINESS.tel}`} data-contact="call"><span class="ms" aria-hidden="true">call</span><span class="sh-ph">{BUSINESS.phone}</span></a>
      <a class="btn btn-amber sh-cta" href={Q} data-swivl="quote">Free Quote</a>
    </div>
    <details class="sh-mob">
      <summary aria-label="Menu"><svg class="o" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg><span class="ms c" aria-hidden="true">close</span></summary>
      <nav class="sh-mp" aria-label="Mobile">
        <div class="mp-act">
          <a class="btn btn-amber" href={`tel:${BUSINESS.tel}`} data-contact="call"><span class="ms" aria-hidden="true">call</span>Call {BUSINESS.phone}</a>
          <a class="btn mp-q" href={Q} data-swivl="quote">Free Quote</a>
        </div>
        {MENU.map((m) => m.items ? (
          <details class="mp-g">
            <summary>{m.label}<span class="ms" aria-hidden="true">expand_more</span></summary>
            {m.items.map(([h, n, top]) => <a class:list={[!top && m.sub && 'sub']} href={h}>{top ? <strong>{n}</strong> : n}</a>)}
          </details>
        ) : <a class="mp-l" href={m.href}>{m.label}</a>)}
        <button type="button" class="mp-x" data-close>Close menu</button>
      </nav>
    </details>
  </div>
</header>
<script is:inline>
(() => {
  const h = document.querySelector('header.sh'); if (!h || h.dataset.ddInit) return; h.dataset.ddInit = '1';
  const dds = [...h.querySelectorAll('.sh-dd, .mp-g')], mob = h.querySelector('.sh-mob');
  const closeAll = (keep) => dds.forEach((d) => { if (d !== keep) d.open = false; });
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  dds.forEach((d) => {
    let t;
    d.addEventListener('toggle', () => { if (d.open) closeAll(d); });
    d.addEventListener('mouseenter', () => { if (!fine.matches) return; clearTimeout(t); if (!d.open) { d.open = true; d.dataset.hov = Date.now(); } });
    d.addEventListener('mouseleave', () => { if (!fine.matches) return; t = setTimeout(() => { d.open = false; }, 180); });
    d.querySelector('summary').addEventListener('click', (e) => { if (d.open && Date.now() - (+d.dataset.hov || 0) < 700) e.preventDefault(); });
  });
  if (mob) { mob.addEventListener('toggle', () => document.body.classList.toggle('sh-lock', mob.open)); mob.querySelector('[data-close]').addEventListener('click', () => { mob.open = false; mob.querySelector('summary').focus(); }); mob.querySelectorAll('.sh-mp a').forEach((a) => a.addEventListener('click', () => { mob.open = false; })); }
  document.addEventListener('click', (e) => { if (!e.target.closest('.sh-dd, .mp-g')) closeAll(); });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const o = h.querySelector('.sh-dd[open], .sh-mob[open]'); if (!o) return;
    o.open = false; o.querySelector('summary').focus();
  });
  h.addEventListener('focusout', (e) => { const d = e.target.closest('.sh-dd'); if (d && !d.contains(e.relatedTarget)) d.open = false; });
})();
</script>
