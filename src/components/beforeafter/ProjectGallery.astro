---
// Grid of real after-only project photos with visible captions.
import Pic from './Pic.astro';
interface Props { items: any[] }
const { items } = Astro.props;
---
<ul class="pg" role="list">
  {items.map((it) => <li><figure><Pic img={it} sizes="(min-width: 1024px) 33vw, (min-width: 600px) 50vw, 100vw" /><figcaption>{it.caption}</figcaption></figure></li>)}
</ul>
<style>
.pg{list-style:none;margin:0;padding:0;display:grid;gap:1rem;grid-template-columns:1fr}
@media (min-width:600px){.pg{grid-template-columns:repeat(2,1fr)}}
@media (min-width:1024px){.pg{grid-template-columns:repeat(3,1fr)}}
.pg figure{margin:0}.pg :global(picture),.pg :global(img){display:block;width:100%;height:auto;aspect-ratio:3/4;object-fit:cover;border-radius:12px}
.pg figcaption{margin-top:.45rem;font-size:.95rem;line-height:1.4}
</style>
