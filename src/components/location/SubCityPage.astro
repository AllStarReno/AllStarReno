---
// Stage 4: AI Studio LocationPage layout for sub-service x city pages (/<category>/<sub>/<city>).
// Hero + local spec card, sub-service selector tabs, AEO quick answer, local fit, included features,
// comparison table, local guide, NAP block, nearby links, FAQ, contact block (LeadForm with sub-service preselected),
// fine-print disclaimer. JSON-LD: Service + FAQPage + BreadcrumbList on the shared @graph. No prices or ratings.
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../global/SiteHeader.astro';
import SiteFooter from '../global/SiteFooter.astro';
import ContactBlock from '../global/ContactBlock.astro';
import '../../styles/ui.css';
import { loadPages } from '../../lib/legacy.mjs';
import { buildGraph } from '../../lib/schema.mjs';
import { nearestCities } from '../../data/cities.mjs';
import { LOCAL } from '../../data/city-guides.mjs';
import { SERVICE_PAGES } from '../../data/service-pages.mjs';
import { SITE, BUSINESS } from '../../data/business.mjs';
import { SUBS, ANGLES, parseSubCity, visitLine, SUB_CITY_NOINDEX } from '../../data/sub-locations.mjs';
import { THIN_TOWNS } from '../../data/city-pages.mjs';
interface Props { slug: string }
const { slug } = Astro.props;
const { sub, city } = parseSubCity(slug);
const cat = sub.cat;
const d = SERVICE_PAGES[`${cat.slug}/${sub.slug}`];
const A = ANGLES[sub.slug];
const L = LOCAL[city.slug];
const url = `${SITE}/${slug}`;
const place = `${city.name}, AR`;
const miles = city.milesFromHQ;
const ZIP = city.zips.join(', ');
const indexable = !SUB_CITY_NOINDEX.has(slug);
const okCity = (c) => !THIN_TOWNS.includes(c.slug);

const title = `${sub.name} in ${place} | All-Star Renovations`;
const description = `${sub.name} in ${city.name}, ${city.county} from All-Star Renovations of Conway${miles ? `, about ${miles} miles away` : ''}. Free in-home quote, lifetime product + 5-year workmanship warranty. Call ${BUSINESS.phone}.`;
const q = `Who offers ${sub.name.toLowerCase()} in ${city.name}, AR?`;
const a = `All-Star Renovations, a locally owned Conway, AR company, provides ${sub.name.toLowerCase()} in ${city.name} and ${city.county} (ZIP ${ZIP})${miles ? `, about ${miles} miles from our office` : ''}. We have 20 years of experience, have been in business since 2014 and have completed 500+ remodels. Work is backed by a lifetime product warranty + 5-year workmanship warranty. Call ${BUSINESS.phone} for a free in-home quote.`;
const lead = `${A.fit(city, L)} We help ${A.who}, with free in-home quotes across ${L.areas.slice(0, 2).join(' and ')}.`;

const faqs = [
  { q, a },
  A.faq(city),
  { q: `Which ${city.name} ZIP codes do you serve for ${sub.name.toLowerCase()}?`, a: `We serve ZIP ${ZIP} and nearby ${city.county} addresses${L.areas.length ? `, including ${L.areas.slice(0, 3).join(', ')}` : ''}. Just outside town? Call ${BUSINESS.phone} to confirm.` },
  { q: `How do I get a quote for a ${A.noun} in ${city.name}?`, a: `Request a quote on this page or call ${BUSINESS.phone}. ${visitLine(city)} We measure, review options and give you a written quote at no cost.` },
  { q: 'What warranty comes with the work?', a: 'A lifetime product warranty + 5-year workmanship warranty, plus our 100% Customer Guarantee. See the warranty page for details.' },
  { q: 'Do you offer financing?', a: 'Yes. Financing is available through Acorn Finance, HFS Financial and RenoFi. Rates, terms and approval are set by each lender.' },
];

const crumbs = [
  { name: 'Home', url: `${SITE}/` },
  { name: cat.name, url: `${SITE}/${cat.slug}` },
  { name: sub.name, url: `${SITE}/${cat.slug}/${sub.slug}` },
  { name: place, url },
];

const pages = loadPages();
const shell = pages.find((p) => p.slug === 'service-areas/conway');
const site = shell.jsonld.flatMap((n) => (n['@graph'] || [n])).filter((n) => /\/#/.test(n['@id'] || ''));
const page = { ...shell, slug, url, title, description, body: 'id="main"', robots: '', indexable,
  jsonld: [{ '@context': 'https://schema.org', '@graph': site }, { '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })) }] };
const g = buildGraph(page);
const SVC = `${url}#service`, FAQ = `${url}#faq`, PAGE = `${url}#webpage`;
g['@graph'] = g['@graph'].filter((n) => !['FAQPage', 'Service', 'City'].some((t) => [].concat(n['@type']).includes(t)));
g['@graph'].push({ '@type': 'City', '@id': `${url}#place`, name: place, geo: { '@type': 'GeoCoordinates', ...city.geo }, containedInPlace: { '@type': 'AdministrativeArea', name: `${city.county}, Arkansas` } });
g['@graph'].push({ '@type': 'Service', '@id': SVC, name: `${sub.name} in ${place}`, serviceType: sub.name, category: cat.name, url, description: a,
  provider: { '@id': `${SITE}/#business` }, areaServed: { '@id': `${url}#place` }, isPartOf: { '@id': `${SITE}/${cat.slug}/${sub.slug}#service` },
  termsOfService: `${SITE}/warranty` });
g['@graph'].push({ '@type': 'FAQPage', '@id': FAQ, url, isPartOf: { '@id': PAGE }, mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\*/g, '') } })) });
for (const n of g['@graph']) if (n['@id'] === PAGE) { n.mainEntity = { '@id': SVC }; n.about = { '@id': `${url}#place` }; n.speakable = { '@type': 'SpeakableSpecification', cssSelector: ['h1', '#speakable-summary'] }; }

const here = `/${slug}`;
const tabs = [{ href: `/${cat.slug}/${city.slug}`, label: `All ${cat.name.replace(' Services', '').toLowerCase()}` }, ...cat.subs.filter((s) => SUBS.some((x) => x.slug === s.slug)).map((s) => ({ href: `/${cat.slug}/${s.slug}/${city.slug}`, label: s.name }))];
const near = nearestCities(city.slug, 6).filter(okCity).slice(0, 4);
const otherCats = SUBS.filter((s) => s.cat.slug !== cat.slug).filter((_, i) => i % 2 === 0).slice(0, 4);
const tel = BUSINESS.tel;
const timeline = /1-2 day/i.test(d.timeline) ? `${d.timeline}*` : d.timeline;
---
<Layout page={page} graph={g}>
  <SiteHeader current={cat.slug} />
  <main id="main" class="dk ui sp lp" style="background:#0F2B48">
    <section class="sp-hero" aria-labelledby="hero-h">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb"><ol>{crumbs.map((c, i) => i < crumbs.length - 1 ? <li><a href={new URL(c.url).pathname}>{c.name}</a> <span aria-hidden="true">›</span></li> : <li aria-current="page">{c.name}</li>)}</ol></nav>
        <div class="sp-grid">
          <div>
            <span class="pill"><span class="ms" aria-hidden="true">location_on</span>Hyper-local · {city.county}</span>
            <h1 id="hero-h">{sub.name} in <em>{place}</em></h1>
            <p class="sp-lead">{lead}</p>
            <ul class="sp-badges">
              <li><span class="ms" aria-hidden="true">workspace_premium</span>20 Years of Experience</li>
              <li><span class="ms" aria-hidden="true">event</span>In Business Since 2014</li>
              <li><span class="ms" aria-hidden="true">verified_user</span>Lifetime product + 5-year workmanship warranty</li>
            </ul>
            <div class="ctas">
              <a class="btn btn-amber" href="#contact"><span class="ms" aria-hidden="true">event_available</span>Get Free In-Home Quote</a>
              <a class="btn btn-ghost" href={`tel:${tel}`} data-contact="call"><span class="ms" aria-hidden="true">call</span>{BUSINESS.phone}</a>
            </div>
          </div>
          <aside class="card sp-spec" aria-labelledby="spec-h">
            <div class="sp-spec-b">
              <h2 id="spec-h"><span class="ms" aria-hidden="true">military_tech</span>{sub.name}: {city.name} Specs</h2>
              <dl>
                <div><dt>Typical timeline</dt><dd>{timeline}</dd></div>
                <div><dt>Distance</dt><dd>{miles ? `About ${miles} mi from Conway` : 'Home base'}</dd></div>
                <div><dt>ZIP codes</dt><dd>{ZIP}</dd></div>
                <div><dt>Pricing</dt><dd class="ok">Free in-home quote</dd></div>
                <div><dt>Warranty</dt><dd>Lifetime product + 5-yr workmanship</dd></div>
                <div><dt>Experience</dt><dd class="am">500+ remodels</dd></div>
              </dl>
              <a class="btn btn-amber sp-spec-cta" href="#contact">Schedule Your Estimate <span class="ms" aria-hidden="true">arrow_forward</span></a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <nav class="wrap lp-tabs" aria-label={`${cat.name} in ${city.name}`}>
      {tabs.map((t) => <a href={t.href} aria-current={t.href === here ? 'page' : undefined}>{t.label}</a>)}
    </nav>

    <section class="wrap sp-sec" aria-labelledby="ans-q">
      <div class="ans" id="speakable-summary" data-quick-answer style="max-width:none;margin:0">
        <span class="k"><span class="ms" aria-hidden="true">help</span>Quick answer: {sub.name} in {city.name}</span>
        <h2 id="ans-q">{q}</h2>
        <p>{a}</p>
      </div>
    </section>

    <section class="wrap sp-sec" aria-labelledby="loc-h">
      <div class="card lp-local">
        <h2 class="sp-h2" id="loc-h">{sub.name} for {city.name} Homes</h2>
        <p>{L.housing}</p>
        <p>{visitLine(city)} {L.route}</p>
        <div class="lp-cols">
          <div><h3><span class="ms" aria-hidden="true">holiday_village</span>Areas we serve in {city.name}</h3><ul>{L.areas.map((x) => <li>{x}</li>)}</ul></div>
          <div><h3><span class="ms" aria-hidden="true">pin_drop</span>Near local landmarks</h3><ul>{L.landmarks.map((x) => <li>{x}</li>)}</ul></div>
          <div><h3><span class="ms" aria-hidden="true">checklist</span>Before your visit</h3><p>{A.prep}</p></div>
        </div>
      </div>
    </section>

    <section class="wrap sp-sec" aria-labelledby="feat-h">
      <h2 class="sp-h2" id="feat-h">Included With Every {sub.name.replace(/s$/, '')} Project</h2>
      <ul class="sp-feat">{d.features.map((f) => <li class="card"><span class="ms" aria-hidden="true">check_circle</span>{f}</li>)}</ul>
    </section>

    <section class="wrap sp-sec" aria-labelledby="cmp-h">
      <div class="card sp-cmp">
        <h2 class="sp-h2" id="cmp-h">Typical Contractor vs. All-Star Renovations in {city.name}</h2>
        <div class="sp-tbl" tabindex="0" role="region" aria-labelledby="cmp-h">
          <table>
            <thead><tr><th scope="col">Aspect</th><th scope="col">Typical contractor</th><th scope="col">All-Star Renovations</th></tr></thead>
            <tbody>{d.compare.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td class="as">{/1-2 days/.test(r[2]) ? `${r[2]}*` : r[2]}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="wrap sp-sec" aria-labelledby="nap-h">
      <div class="card" itemscope itemtype="https://schema.org/HomeAndConstructionBusiness">
        <h2 class="sp-h2" id="nap-h" style="margin:0 0 .4rem">Contact All-Star Renovations</h2>
        <p style="margin:0;line-height:1.7"><b itemprop="name">{BUSINESS.name}</b><br />
          <span itemprop="address" itemscope itemtype="https://schema.org/PostalAddress"><span itemprop="streetAddress">{BUSINESS.address.streetAddress}</span>, <span itemprop="addressLocality">{BUSINESS.address.addressLocality}</span>, <span itemprop="addressRegion">{BUSINESS.address.addressRegion}</span> <span itemprop="postalCode">{BUSINESS.address.postalCode}</span></span><br />
          <a href={`tel:${BUSINESS.tel}`} data-contact="call" itemprop="telephone">{BUSINESS.phone}</a></p>
        <p style="margin:.4rem 0 0;font-size:.9rem;opacity:.85">20 Years of Experience · In Business Since 2014 · Serving {place} from our Conway office.</p>
      </div>
    </section>

    <section class="wrap sp-sec" aria-labelledby="near-h">
      <div class="card sp-cities">
        <div class="sec-head" style="margin-bottom:1.5rem"><span class="pill">Nearby</span><h2 id="near-h">{sub.name} Near {city.name}</h2></div>
        <ul>{near.map((c) => <li><a href={`/${cat.slug}/${sub.slug}/${c.slug}`}><b>{c.name}, AR</b><small>{c.county}</small></a></li>)}</ul>
        <p class="more"><a href={`/${cat.slug}/${sub.slug}`}>{sub.name} across Central Arkansas →</a> · <a href={`/service-areas/${city.slug}`}>All services in {city.name} →</a></p>
      </div>
    </section>

    <section class="wrap sp-sec" aria-labelledby="rel-h">
      <h2 class="sp-h2" id="rel-h">More Services in {city.name}</h2>
      <div class="sp-rel">{otherCats.map((s) => <a href={`/${s.cat.slug}/${s.slug}/${city.slug}`}>{s.name} in {city.name}</a>)}<a href="/financing">Financing</a><a href="/warranty">Warranty</a></div>
    </section>

    <section class="sec" aria-labelledby="fq-h" style="background:#0a1e33">
      <div class="wrap">
        <div class="sec-head"><span class="pill">FAQs</span><h2 id="fq-h">{sub.name} Questions in {place}</h2></div>
        <div class="fq">{faqs.map((f, i) => <details open={i === 0}><summary>{f.q}<span class="ms" aria-hidden="true">expand_more</span></summary><div class="a">{f.a}</div></details>)}</div>
      </div>
    </section>

    <ContactBlock slug={slug} city={city.name} source={`location_page:${slug}`} topic={d.topic} />

    <section class="wrap lp-fine" aria-label="Fine print">
      <p>* Timelines, costs and results described on this page are typical and not guaranteed. Every home is different; your schedule, price and outcome depend on site conditions, material availability and the options you choose, and are confirmed in your written quote. Warranty terms are on our <a href="/warranty">warranty page</a>; financing is subject to lender approval.</p>
    </section>
  </main>
  <SiteFooter />
</Layout>
<style is:global>
.lp-fine{padding-top:1.5rem;padding-bottom:1.5rem}.lp-fine p{margin:0;font-size:.78rem;line-height:1.6;color:#a9b8c9}.lp-fine a{color:#fdba74}
.lp-local>p+p{margin-top:-.5rem}
</style>
