---
// Accessible FAQ (native <details>). Pair with a FAQPage node in the page graph.
interface Props { items: { q: string; a: string }[]; heading?: string }
const { items, heading = 'Frequently asked questions' } = Astro.props;
---
<section class="faq" aria-labelledby="faq-h">
  <h2 id="faq-h">{heading}</h2>
  {items.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
</section>
<style>
  .faq summary { min-height: 44px; display: flex; align-items: center; cursor: pointer; font-weight: 700; }
  .faq summary:focus-visible { outline: 3px solid var(--asr-amber); outline-offset: 2px; }
</style>
