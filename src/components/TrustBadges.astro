---
// Reusable trust-badge strip. Grayscale by default, color on hover/focus. Badges link only when href is set in business.mjs.
import { BADGES, BUSINESS } from '../data/business.mjs';
import { REVIEW_PLATFORMS } from '../data/review-summary.mjs';
// 21 verified public reviews, all 5.0 stars (checked 2026-10-24): Google 10, Bark 5, TrustIndex 2, Facebook 1, BBB 1, Allbiz 1, BuildZoom 1.
// Plain text only: never add rating/review schema.
const RP = REVIEW_PLATFORMS.map((p) => [p.name, p.url]);
interface Props { title?: string; note?: string; tone?: 'dark' | 'light'; compact?: boolean }
const { title, note, tone = 'dark', compact = false } = Astro.props;
const H = compact ? 40 : 52;
---
<div class:list={['tb', `tb-${tone}`, compact && 'tb-c']}>
  {title && <h2 class="tb-t">{title}</h2>}
  {!compact && <p class="tb-r"><strong>5.0 stars across 21 verified reviews</strong> on {RP.map(([n,u],i) => <>{i ? (i === RP.length - 1 ? ' and ' : ', ') : ''}<a href={u} target="_blank" rel="noopener">{n}</a></>)}</p>}
  {!compact && <p class="tb-r"><a href={BUSINESS.gbp} target="_blank" rel="noopener">5.0 on Google · 10 reviews</a> · <a href="/reviews">Read all 21 reviews</a></p>}
  {!compact && <p class="tb-g">Google Verified on Google Local Services Ads</p>}
  {!compact && <p class="tb-g"><strong>Veteran-Owned</strong> · {BUSINESS.coverage} · {BUSINESS.guarantee} · {BUSINESS.emergency}</p>}
  {note && <p class="tb-n">{note}</p>}
  <ul class="tb-l" role="list">
    {BADGES.map((b) => {
      const img = <img src={`/badges/${b.id}.webp`} alt={b.alt} width={Math.round(b.w * H / b.h)} height={H} loading="lazy" decoding="async" />;
      return <li>{b.href ? <a href={b.href} target="_blank" rel="noopener">{img}<span class="sr-only"> (opens in new tab)</span></a> : <span>{img}</span>}</li>;
    })}
  </ul>
</div>
<style>
.tb{max-width:72rem;margin:0 auto;padding:2rem 1.25rem;text-align:center}
.tb-c{padding:1.25rem 0 1.5rem;max-width:none}
.tb-t{font-size:1.25rem;font-weight:800;margin:0 0 .4rem}
.tb-r,.tb-g{margin:0 0 .5rem;font-size:.95rem}.tb-r a{text-decoration:underline}.tb-light .tb-r,.tb-light .tb-g{color:#0f172a}.tb-light .tb-r a{color:#9a3412}.tb-dark .tb-r,.tb-dark .tb-g{color:#fff}.tb-dark .tb-r a{color:#fdba74}
.tb-n{margin:0 0 1rem;font-size:.9rem}
.tb-light .tb-t{color:#0f172a}.tb-light .tb-r,.tb-g{margin:0 0 .5rem;font-size:.95rem}.tb-r a{text-decoration:underline}.tb-light .tb-r,.tb-light .tb-g{color:#0f172a}.tb-light .tb-r a{color:#9a3412}.tb-dark .tb-r,.tb-dark .tb-g{color:#fff}.tb-dark .tb-r a{color:#fdba74}
.tb-n{color:#334155}
.tb-dark .tb-t{color:#fff}.tb-dark .tb-r,.tb-g{margin:0 0 .5rem;font-size:.95rem}.tb-r a{text-decoration:underline}.tb-light .tb-r,.tb-light .tb-g{color:#0f172a}.tb-light .tb-r a{color:#9a3412}.tb-dark .tb-r,.tb-dark .tb-g{color:#fff}.tb-dark .tb-r a{color:#fdba74}
.tb-n{color:#cbd6e2}
.tb-l{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem}
.tb-l li>*{display:flex;align-items:center;justify-content:center;background:#fff;border-radius:.6rem;padding:.35rem .5rem;min-height:44px}
.tb-l img{display:block;height:52px;width:auto;max-width:100%;filter:grayscale(1);opacity:.85;transition:filter .25s,opacity .25s}
.tb-l li>*:hover img,.tb-l li>*:focus-visible img{filter:none;opacity:1}
.tb-c .tb-l img{height:40px}
.tb-l a:focus-visible{outline:2px solid #f59e0b;outline-offset:2px}
@media(prefers-reduced-motion:reduce){.tb-l img{transition:none}}
</style>
