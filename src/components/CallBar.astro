---
// Mobile tap-to-call / text bar (only rendered on pages that don't already include one).
import { BUSINESS } from '../data/business.mjs';
---
<div class="callbar" role="region" aria-label="Contact All-Star Renovations">
  <a href={`tel:${BUSINESS.tel}`} data-contact="call">Call {BUSINESS.phone}</a>
  <a href={`sms:${BUSINESS.tel}`} data-contact="sms">Text us</a>
</div>
<style>
  .callbar { position: fixed; inset: auto 0 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; padding: .5rem; background: var(--asr-navy); z-index: 60; }
  .callbar a { min-height: 48px; display: flex; align-items: center; justify-content: center; border-radius: .75rem; font-weight: 800; background: var(--asr-amber); color: var(--asr-navy); }
  .callbar a + a { background: transparent; color: #fff; border: 2px solid #fff; }
  @media (min-width: 1024px) { .callbar { display: none; } }
</style>
