---
// Phone-only sticky contact bar (Call / Text / Free Quote), matching the homepage bar.
// Reserves its own height with body padding so it never covers content or forms (no layout shift).
import { BUSINESS } from '../data/business.mjs';
interface Props { quote?: string }
const { quote = 'https://client.swivl.tech/all-star-renovate-318dbc/instant-quote?widget=instant-quote' } = Astro.props;
const swivl = quote.startsWith('http');
---
<div class="callbar" role="region" aria-label="Contact All-Star Renovations">
  <a class="cb-call" href={`tel:${BUSINESS.tel}`} data-contact="call">Call</a>
  <a class="cb-text" href={`sms:${BUSINESS.tel}`} data-contact="sms">Text</a>
  <a class="cb-quote" href={quote} data-swivl={swivl ? 'quote' : undefined}>Free Quote</a>
</div>
<style is:global>
  .callbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 80; display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; padding: .5rem .75rem max(.5rem, env(safe-area-inset-bottom)); background: rgba(11,19,41,.96); border-top: 1px solid rgba(255,255,255,.15); }
  .callbar a { min-height: 48px; display: flex; align-items: center; justify-content: center; border-radius: .75rem; font-weight: 700; font-size: .9rem; text-decoration: none; }
  .callbar .cb-call { background: #c2410c; color: #fff; }
  .callbar .cb-text { background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2); color: #fff; }
  .callbar .cb-quote { background: #fff; color: #0b1329; }
  body:has(.callbar) { padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
  @media (min-width: 1024px) { .callbar { display: none; } body:has(.callbar) { padding-bottom: 0; } }
</style>
