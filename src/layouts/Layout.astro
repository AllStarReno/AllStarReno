---
import NewoChat from '../components/NewoChat.astro';
// Site-wide <head>: canonical, meta/OG/Twitter, robots, and a single JSON-LD @graph.
import '../styles/tokens.css';
import { SITE } from '../data/business.mjs';
interface Props { page: any; graph: any }
const { page, graph } = Astro.props;
const { _hasArticle, ...ld } = graph;
const robots = page.indexable ? 'index,follow,max-image-preview:large,max-snippet:-1' : 'noindex,follow';
const hasMain = page.body.includes('id="main"');
const ogImage = page.ogImage || `${SITE}/assets/img/og-image.jpg`;
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{page.title}</title>
  <meta name="description" content={page.description} />
  <meta name="robots" content={robots} />
  {page.indexable && <link rel="canonical" href={page.url} />}
  <meta name="theme-color" content="#0F2B48" />
  <meta name="geo.region" content="US-AR" /><meta name="geo.placename" content="Conway, Arkansas" /><meta name="geo.position" content="35.0887;-92.4421" /><meta name="ICBM" content="35.0887, -92.4421" />
  <meta property="og:site_name" content="All-Star Renovations" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content={_hasArticle ? 'article' : page.ogType} />
  <meta property="og:title" content={page.title} />
  <meta property="og:description" content={page.description} />
  <meta property="og:url" content={page.url} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={page.ogImageAlt || page.title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@All_StarReno" />
  <meta name="twitter:title" content={page.title} />
  <meta name="twitter:description" content={page.description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={page.ogImageAlt || page.title} />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <Fragment set:html={page.assets.filter((a) => !/rel="?(icon|apple-touch-icon|manifest|shortcut icon)"?/i.test(a)).join('\n')} />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body class={page.bodyClass}>
  {hasMain && <a class="skip-link" href="#main">Skip to main content</a>}
  <slot />
  <NewoChat />
  <!-- TrustedForm -->
  <script is:inline type="text/javascript">(function(){var tf=document.createElement('script');tf.type='text/javascript';tf.async=true;tf.src=("https:"==document.location.protocol?'https':'http')+'://api.trustedform.com/trustedform.js?field=xxTrustedFormCertUrl&use_tagged_consent=true&l='+new Date().getTime()+Math.random();var s=document.getElementsByTagName('script')[0];s.parentNode.insertBefore(tf,s);})();</script>
  <noscript><img src='https://api.trustedform.com/ns.gif' alt="" /></noscript>
  <!-- End TrustedForm -->
</body>
</html>
