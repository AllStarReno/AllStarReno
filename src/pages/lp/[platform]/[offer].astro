---
// Paid-ad landing pages (Meta / Google Ads / Microsoft Ads). No main nav, noindex, not in sitemap.
import '../../../styles/tokens.css';
import LeadForm from '../../../components/LeadForm.astro';
import TrustBadges from '../../../components/TrustBadges.astro';
import AdTags from '../../../components/lp/AdTags.astro';
import { PLATFORMS, OFFERS, OFFER_REVIEW_TAGS } from '../../../data/landing-pages.mjs';
import { reviewsFor } from '../../../data/reviews.mjs';
import { SITE, BUSINESS } from '../../../data/business.mjs';
export function getStaticPaths() {
  return PLATFORMS.flatMap((p) => OFFERS.map((o) => ({ params: { platform: p.slug, offer: o.slug }, props: { p, o } })));
}
const { p, o } = Astro.props;
const meta = p.short;
const h1 = meta ? o.social : o.search;
const title = `${o.name} | Free In-Home Estimate | All-Star Renovations`;
const desc = `${o.name} from All-Star Renovations of Conway, AR. 20 years of experience, in business since 2014. Call ${BUSINESS.phone} for a free estimate.`;
const url = `${SITE}/lp/${p.slug}/${o.slug}`;
const A = BUSINESS.address;
const graph = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'HomeAndConstructionBusiness', '@id': `${SITE}/#business`, name: BUSINESS.name, url: `${SITE}/`, telephone: BUSINESS.telSchema, email: BUSINESS.email,
    address: { '@type': 'PostalAddress', ...A }, disambiguatingDescription: BUSINESS.identity },
  { '@type': 'WebPage', '@id': `${url}#webpage`, url, name: title, about: { '@id': `${SITE}/#business` }, breadcrumb: { '@id': `${url}#breadcrumb` } },
  { '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` }, { '@type': 'ListItem', position: 2, name: o.name, item: url }] },
] };
const facts = ['20 Years of Experience', 'In Business Since 2014', '500+ Remodels', 'Lifetime product warranty + 5-year workmanship warranty*'];
const phoneSvg = '<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>';
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="theme-color" content="#0F2B48" />
  <meta property="og:title" content={title} /><meta property="og:description" content={desc} />
  <meta property="og:image" content={`${SITE}/assets/img/og-image.jpg`} /><meta property="og:url" content={url} />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  <AdTags />
</head>
<body class={`lp lp-${p.slug}`}>
  <header class="lp-top">
    <img src="/assets/img/asr-logo.webp" alt="All-Star Renovations" width="32" height="44" fetchpriority="high" />
    <a class="lp-call" href={`tel:${BUSINESS.tel}`} data-contact="call"><Fragment set:html={phoneSvg} /><span>{BUSINESS.phone}</span></a>
  </header>
  <main id="main">
    <section class="lp-hero">
      <div class="lp-copy">
        <p class="lp-kicker">Conway &amp; Central Arkansas · Free In-Home Estimate</p>
        <h1>{h1}</h1>
        <p class="lp-sub">{o.sub}</p>
        <ul class="lp-facts" role="list">{facts.map((f) => <li>{f}</li>)}</ul>
      </div>
      <div class="lp-form"><LeadForm variant="compact" bare slug={o.formSlug} source={`lp_${p.slug}_${o.slug}`} heading={`Get Your Free ${o.name} Estimate`} short={meta} /></div>
      <div class="lp-more">
        <a class="lp-cta" href={`tel:${BUSINESS.tel}`} data-contact="call"><Fragment set:html={phoneSvg} />Call {BUSINESS.phone}</a>
        {!meta && <ul class="lp-points">{o.points.map((x) => <li>{x}</li>)}</ul>}
      </div>
    </section>
    {meta && <section class="lp-band"><ul class="lp-points">{o.points.map((x) => <li>{x}</li>)}</ul></section>}
    <section class="lp-trust"><TrustBadges title="Trusted by Central Arkansas Homeowners" tone="light" /></section>
    <section class="lp-reviews" aria-labelledby="lp-rev">
      <h2 id="lp-rev">What Our Customers Say</h2>
      <div class="lp-rgrid">{reviewsFor({ tags: OFFER_REVIEW_TAGS[Astro.params.offer] || ['bathroom-remodeling'], n: 3 }).map((t) => <figure><blockquote>“{t.text}”</blockquote><figcaption>{t.name} · {t.platform} · <a href={t.url} target="_blank" rel="noopener">Original review</a></figcaption></figure>)}</div>
    </section>
    <section class="lp-why">
      <h2>Why All-Star Renovations</h2>
      <ul role="list">
        <li><strong>20 Years of Experience</strong></li>
        <li><strong>In Business Since 2014</strong></li>
        <li><strong>500+ Remodels</strong> across Central Arkansas</li>
        <li><strong>Lifetime product warranty + 5-year workmanship warranty</strong>*</li>
      </ul>
      <a class="lp-cta" href={`tel:${BUSINESS.tel}`} data-contact="call"><Fragment set:html={phoneSvg} />Call {BUSINESS.phone}</a>
      <a class="lp-cta lp-alt" href="#request-visit">Get My Free Estimate</a>
    </section>
  </main>
  <footer class="lp-foot">
    <p><strong>{BUSINESS.name}</strong> · {A.streetAddress}, {A.addressLocality}, {A.addressRegion} {A.postalCode} · <a href={`tel:${BUSINESS.tel}`}>{BUSINESS.phone}</a></p>
    <p>{BUSINESS.identity}</p>
    <p class="lp-fine">* Timelines, costs and results shown or described are typical and are not guaranteed. Actual install time, pricing and results vary with each home, product selection, site conditions and scope. Warranty terms are subject to the written warranty provided with your contract. Financing, if offered, is subject to lender approval. Testimonials reflect individual experiences.</p>
    <p><a href="/privacy-policy">Privacy Policy</a> · <a href="/terms-and-conditions">Terms</a> · <a href="/terms-and-conditions#sms-terms">SMS Terms</a></p>
  </footer>
  <script is:inline type="text/javascript">(function(){var tf=document.createElement('script');tf.type='text/javascript';tf.async=true;tf.src='https://cdn.trustedform.com/bootstrap.js?field=xxTrustedFormCertUrl&use_tagged_consent=true&l='+new Date().getTime()+Math.random();var s=document.getElementsByTagName('script')[0];s.parentNode.insertBefore(tf,s)})();</script>
  <noscript><img src="https://api.trustedform.com/ns.gif" alt="" /></noscript>
  <!-- Vercel Web Analytics + Speed Insights (cookie-free; replaces stale PRs #1/#2) -->
  <script is:inline>window.va=window.va||function(){(window.vaq=window.vaq||[]).push(arguments)};window.si=window.si||function(){(window.siq=window.siq||[]).push(arguments)};</script>
  <script is:inline defer src="/_vercel/insights/script.js"></script>
  <script is:inline defer src="/_vercel/speed-insights/script.js"></script>
</body>
</html>
<style is:global>
.lp{margin:0;font-family:var(--asr-font-body);color:#0f172a;background:#fff;line-height:1.5;-webkit-text-size-adjust:100%}
.lp *{box-sizing:border-box}
.lp-top{display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding:.5rem 1rem;background:var(--asr-navy);position:sticky;top:0;z-index:20}
.lp-top img{height:40px;width:auto}
.lp-call{display:inline-flex;align-items:center;gap:.4rem;background:var(--asr-amber);color:var(--asr-amber-ink);font-weight:800;text-decoration:none;padding:.55rem .8rem;border-radius:.6rem;min-height:44px;white-space:nowrap}
.lp-hero{background:var(--asr-navy);color:#fff;padding:.75rem 1rem 1.5rem;display:grid;gap:.75rem;max-width:none}
.lp-copy,.lp-form,.lp-more{width:100%;max-width:34rem;margin:0 auto}
.lp-kicker{margin:0 0 .3rem;font-size:.8rem;font-weight:700;color:var(--asr-amber);text-transform:uppercase;letter-spacing:.04em}
.lp h1{font-family:var(--asr-font-head);font-size:1.45rem;line-height:1.15;margin:0 0 .5rem;font-weight:800}
.lp-sub{margin:0 0 .75rem;color:#dbe4ee}
.lp-facts{list-style:none;margin:0 0 .9rem;padding:0;display:flex;flex-wrap:wrap;gap:.35rem}
.lp-facts li{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:999px;padding:.2rem .6rem;font-size:.78rem;font-weight:700}
.lp-cta{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;width:100%;background:var(--asr-amber);color:var(--asr-amber-ink);font-weight:800;font-size:1.05rem;text-decoration:none;padding:.8rem 1rem;border-radius:.7rem;min-height:48px;margin:.25rem 0}
.lp-alt{background:#fff;color:var(--asr-navy);border:2px solid var(--asr-navy)}
.lp-points{margin:.75rem 0 0;padding-left:1.2rem}
.lp-points li{margin:.2rem 0}
.lp-band{padding:1rem 1.25rem;background:#f1f5f9}.lp-band .lp-points{max-width:34rem;margin:0 auto}
.lp-reviews,.lp-why{padding:2rem 1.25rem;max-width:72rem;margin:0 auto}
.lp h2{font-family:var(--asr-font-head);font-size:1.35rem;margin:0 0 1rem;text-align:center}
.lp-rgrid{display:grid;gap:1rem}
.lp-rgrid figure{margin:0;background:#f8fafc;border:1px solid #e2e8f0;border-radius:.8rem;padding:1rem}
.lp-rgrid blockquote{margin:0 0 .5rem;font-style:italic}
.lp-rgrid figcaption{font-weight:800;color:#9a3412}
.lp-why ul{list-style:none;padding:0;margin:0 auto 1rem;max-width:34rem;display:grid;gap:.4rem}
.lp-why li{background:#f8fafc;border-left:4px solid var(--asr-amber);padding:.6rem .8rem;border-radius:.4rem}
.lp-why .lp-cta{max-width:34rem;display:flex;margin:.4rem auto}
.lp-foot{background:#0b1f35;color:#cbd6e2;padding:1.5rem 1.25rem 2.5rem;font-size:.85rem}
.lp-foot p{max-width:60rem;margin:.4rem auto}
.lp-foot a{color:#fff}
.lp .lf-sms,.lp .lf-sms a,.lp .lf-consent,.lp .lf-consent a{color:#d5dee8}
.lp-fine{font-size:.75rem;color:#9fb0c3}
@media (min-width:900px){
  .lp-hero{grid-template-columns:1fr 1fr;padding:2.5rem 2rem;align-items:start;max-width:none}
  .lp-copy,.lp-more{max-width:36rem;margin:0 0 0 auto;grid-column:1}.lp-form{margin:0 auto 0 0;grid-column:2;grid-row:1 / span 2}
  .lp h1{font-size:2.4rem}.lp-cta{width:auto}
  .lp-rgrid{grid-template-columns:repeat(3,1fr)}
}
</style>
