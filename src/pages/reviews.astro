---
// /reviews: verified public reviews as visible, quotable plain text. Individual Review schema not used; business aggregateRating comes from src/lib/schema.mjs.
// JSON-LD here is limited to the shared business/site graph + WebPage (FAQPage) + BreadcrumbList.
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/global/SiteHeader.astro';
import SiteFooter from '../components/global/SiteFooter.astro';
import CallBar from '../components/CallBar.astro';
import ContactBlock from '../components/global/ContactBlock.astro';
import '../styles/ui.css';
import { loadPages } from '../lib/legacy.mjs';
import { buildGraph } from '../lib/schema.mjs';
import { SITE, BUSINESS } from '../data/business.mjs';
import { REVIEWS } from '../data/reviews.mjs';
import { REVIEW_TOTAL, REVIEW_CHECKED, REVIEW_PLATFORMS, REVIEW_FAQS, GOOGLE_REVIEW_LINK } from '../data/review-summary.mjs';

const legacy = loadPages().find((p) => p.slug === 'warranty');
const URL = `${SITE}/reviews`;
const page = { ...legacy, slug: 'reviews', url: URL, file: 'src/pages/reviews.astro', body: 'id="main"', jsonld: [], hasBreadcrumb: true, indexable: true,
  title: 'Customer Reviews: 21 Verified 5-Star Reviews | All-Star Renovations, Conway AR',
  description: 'All-Star Renovations of Conway, AR has 21 verified public reviews, all 5.0 stars, on Google, Bark, TrustIndex, Facebook, BBB, Allbiz and BuildZoom.',
  assets: legacy.assets.filter((a) => !/<script/i.test(a)) };
const graph = buildGraph(page);
for (const n of graph['@graph']) if (n['@id'] === `${URL}#webpage`) Object.assign(n, { '@type': ['WebPage', 'FAQPage'],
  mainEntity: REVIEW_FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
for (const n of graph['@graph']) if (n['@type'] === 'BreadcrumbList') n.itemListElement = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` }, { '@type': 'ListItem', position: 2, name: 'Reviews', item: URL }];
const quotes = [...REVIEWS].sort((a, b) => (b.date || '').localeCompare(a.date || ''));
const fmt = (d) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const list = REVIEW_PLATFORMS.map((p) => p.name);
const names = list.slice(0, -1).join(', ') + ' and ' + list.at(-1);
---
<Layout page={page} graph={graph}>
  <SiteHeader current="reviews" />
  <main id="main" class="dk ui" style="background:#0F2B48">
    <section class="sa-intro" aria-labelledby="hero-h">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a> <span aria-hidden="true">›</span></li><li aria-current="page">Reviews</li></ol></nav>
        <h1 id="hero-h" style="margin-top:1.25rem">All-Star Renovations Reviews in Conway, AR</h1>
        <p class="rv-cta"><a class="btn btn-amber" href="https://client.swivl.tech/all-star-renovate-318dbc/instant-quote?widget=instant-quote" data-swivl="quote">Get your free quote</a> <span aria-hidden="true">·</span> <a class="rv-call" href={`tel:${BUSINESS.tel}`} data-contact="call">Call {BUSINESS.phone}</a></p>
        <section class="ans" id="speakable-summary" data-quick-answer aria-labelledby="ans-q">
          <span class="k">Quick answer</span>
          <h2 id="ans-q">How well reviewed is All-Star Renovations?</h2>
          <p>All-Star Renovations of Conway, Arkansas has {REVIEW_TOTAL} verified public reviews, and every one is 5.0 stars. They are on {names} (checked {REVIEW_CHECKED}).</p>
          <p>Google Guaranteed, veteran-owned, licensed and insured.</p>
        </section>
      </div>
    </section>

    <section class="sec" aria-labelledby="pl-h">
      <div class="wrap">
        <div class="sec-head"><h2 id="pl-h">Reviews by platform</h2><p>Each count links to the original public profile so you can read the reviews yourself.</p></div>
        <table class="rvt">
          <caption class="sr-only">Verified public reviews by platform, checked {REVIEW_CHECKED}</caption>
          <thead><tr><th scope="col">Platform</th><th scope="col">Reviews</th><th scope="col">Rating</th></tr></thead>
          <tbody>
            {REVIEW_PLATFORMS.map((p) => <tr><th scope="row"><a href={p.url} target="_blank" rel="noopener">{p.name}<span class="sr-only"> (opens in new tab)</span></a>{p.note && <small> ({p.note})</small>}</th><td>{p.count}</td><td>5.0</td></tr>)}
          </tbody>
          <tfoot><tr><th scope="row">Total</th><td>{REVIEW_TOTAL}</td><td>5.0</td></tr></tfoot>
        </table>
      </div>
    </section>

    <section class="sec" aria-labelledby="q-h" style="background:#0a1e33">
      <div class="wrap">
        <div class="sec-head"><h2 id="q-h">What customers say, word for word</h2><p>Each quote is copied exactly from a public review page and links to the original.</p></div>
        <div class="rvq">
          {quotes.map((r) => (
            <figure>
              <blockquote>“{r.text}”</blockquote>
              <figcaption><strong>{r.name}</strong> · {r.platform}{r.date ? ` · ${fmt(r.date)}` : ''} · <a href={r.url} target="_blank" rel="noopener">Read the original<span class="sr-only"> on {r.platform} (opens in new tab)</span></a></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="sec" aria-labelledby="hw-h">
      <div class="wrap rvn">
        <h2 id="hw-h">How we count and verify reviews</h2>
        <ul>
          <li>We count only reviews that anyone can read on a public page, and we checked each platform in {REVIEW_CHECKED}.</li>
          <li>Reviews that one site copies from another are not counted twice. We do not quote reviews from anyone who shares the owner’s family name.</li>
          <li>Quotes are never edited. They are shown exactly as written, with the reviewer’s first name and last initial.</li>
          <li>Ratings are shown as plain text here. To see the stars, open each platform’s page.</li>
        </ul>
      </div>
    </section>

    <section class="sec" aria-labelledby="lr-h" style="background:#0a1e33">
      <div class="wrap rvn">
        <h2 id="lr-h">Worked with us? Leave a review</h2>
        <p>Google reviews help Central Arkansas neighbors find a contractor they can trust. It takes about a minute.</p>
        <div class="ctas"><a class="btn btn-amber" href={GOOGLE_REVIEW_LINK} target="_blank" rel="noopener">Leave a Google review<span class="sr-only"> (opens in new tab)</span></a></div>
        <p class="rvs">You can also review us on <a href="https://www.facebook.com/allstarreno1/" target="_blank" rel="noopener">Facebook</a>, <a href={REVIEW_PLATFORMS[4].url} target="_blank" rel="noopener">BBB</a> or <a href={REVIEW_PLATFORMS[1].url} target="_blank" rel="noopener">Bark</a>.</p>
      </div>
    </section>

    <section class="sec" aria-labelledby="fq-h">
      <div class="wrap">
        <div class="sec-head"><span class="pill">FAQ</span><h2 id="fq-h">Review Questions</h2></div>
        <div class="fq">{REVIEW_FAQS.map((f, i) => <details open={i === 0}><summary>{f.q}<span class="ms" aria-hidden="true">expand_more</span></summary><div class="a">{f.a}</div></details>)}</div>
        <p class="rvs" style="text-align:center;margin-top:1.5rem">See our work: <a href="/bathroom-remodeling">Bathroom remodeling</a> · <a href="/kitchen-remodeling">Kitchen remodeling</a> · <a href="/handyman-services">Handyman services</a> · <a href="/portfolio">Gallery</a> · <a href="/service-areas">Service areas</a> · <a href="/about">About us</a></p>
        <p class="rvs" style="text-align:center">{BUSINESS.identity}</p>
      </div>
    </section>

    <ContactBlock slug="reviews" source="reviews_contact" />
  </main>
  <SiteFooter />
  <CallBar />
</Layout>
<style>
.rvt{width:100%;max-width:40rem;margin:0 auto;border-collapse:collapse;color:#e2e8f0}
.rvt th,.rvt td{padding:.7rem .9rem;border-bottom:1px solid rgba(255,255,255,.12);text-align:left}
.rvt td{text-align:right}.rvt thead th:not(:first-child){text-align:right}.rvt tfoot th,.rvt tfoot td{font-weight:800;color:#fff}
.rvt a,.rvn a,.rvs a,.rvq a{color:#fdba74;text-decoration:underline}.rvt small{color:#cbd5e1;font-size:.8rem}
.rvq{display:grid;gap:1rem;grid-template-columns:1fr}@media(min-width:768px){.rvq{grid-template-columns:repeat(2,1fr)}}
.rvq figure{margin:0;padding:1.1rem 1.2rem;border-radius:.9rem;background:#13294a;color:#e2e8f0}
.rvq blockquote{margin:0 0 .75rem;font-style:italic;line-height:1.6}.rvq figcaption{font-size:.88rem;color:#cbd5e1}
.rvn{max-width:48rem;color:#e2e8f0;line-height:1.65}.rvn h2{color:#fff;font-size:1.5rem;font-weight:800;margin:0 0 .75rem}.rvn ul{padding-left:1.2rem}
.rvs{color:#cbd5e1;font-size:.9rem}
</style>
