---
// Stage 2: bathroom-remodeling hub + sub-service pages (AI Studio service layout). City pages stay on the catch-all until stage 3.
import ServicePage from '../../components/service/ServicePage.astro';
import { SERVICE_PAGE_SLUGS } from '../../data/service-pages.mjs';
export function getStaticPaths() {
  return SERVICE_PAGE_SLUGS.filter((s) => s === 'bathroom-remodeling' || s.startsWith('bathroom-remodeling/')).map((s) => ({ params: { sub: s === 'bathroom-remodeling' ? undefined : s.slice('bathroom-remodeling/'.length) }, props: { slug: s } }));
}
---
<ServicePage slug={Astro.props.slug} />
