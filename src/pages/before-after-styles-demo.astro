---
// Hidden design-review page (noindex, not in sitemap): every before/after style with every real pair,
// plus the proposed placement. Not linked from navigation.
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/global/SiteHeader.astro';
import SiteFooter from '../components/global/SiteFooter.astro';
import BeforeAfter from '../components/beforeafter/BeforeAfter.astro';
import ProjectGallery from '../components/beforeafter/ProjectGallery.astro';
import '../styles/ui.css';
import { loadPages } from '../lib/legacy.mjs';
import { buildGraph } from '../lib/schema.mjs';
import { SITE } from '../data/business.mjs';
import { PAIRS, SINGLES } from '../lib/project-photos.mjs';
const legacy = loadPages().find((p) => p.slug === 'warranty');
const URL = `${SITE}/before-after-styles-demo`;
const page = { ...legacy, slug: 'before-after-styles-demo', url: URL, file: 'src/pages/before-after-styles-demo.astro', body: 'id="main"', jsonld: [], hasBreadcrumb: true, indexable: false,
  title: 'Before & After Styles (design review) | All-Star Renovations', description: 'Internal design review of before and after photo display styles.',
  assets: legacy.assets.filter((a) => !/<script/i.test(a)) };
const graph = buildGraph(page);
for (const n of graph['@graph']) if (n['@type'] === 'BreadcrumbList') n.itemListElement = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` }, { '@type': 'ListItem', position: 2, name: 'Before & After Styles', item: URL }];
const STYLES = [
  ['slider', 'A. Drag slider', 'Drag (or use arrow keys) to reveal before vs. after. Best single-image impact.'],
  ['toggle', 'B. Before / After buttons', 'Big tap targets, one photo at a time. Easiest on phones.'],
  ['side', 'C. Side by side', 'Both photos at once with labels. Simple, no interaction.'],
  ['stack', 'D. Stacked with arrow', 'Before above after on phones, side by side with an arrow on wider screens.'],
  ['fade', 'E. Crossfade', 'Hover (desktop) or tap to fade to the before photo.'],
];
---
<Layout page={page} graph={graph}>
  <SiteHeader />
  <main id="main" class="ui" style="background:#f7f8fa;color:#0F2B48">
    <div class="wrap" style="padding:1.5rem 1rem 3rem">
      <h1>Before &amp; After display styles (design review)</h1>
      <p>Hidden preview page, not indexed. All five real project pairs are shown in each style. Photos are real All-Star Renovations projects in Central Arkansas; metadata location is city-level Conway, AR.</p>
      <nav aria-label="Styles"><ul style="display:flex;flex-wrap:wrap;gap:.5rem 1rem;padding:0;list-style:none">{STYLES.map(([v, t]) => <li><a href={`#style-${v}`}>{t}</a></li>)}<li><a href="#gallery">After-only gallery</a></li><li><a href="#placement">Proposed placement</a></li></ul></nav>
      {STYLES.map(([v, t, d]) => (
        <section id={`style-${v}`} aria-labelledby={`h-${v}`} style="margin-top:2.5rem">
          <h2 id={`h-${v}`}>{t}</h2><p>{d}</p>
          <div class="demo-grid">{PAIRS.map((p) => <BeforeAfter pair={p} variant={v} />)}</div>
        </section>
      ))}
      <section id="gallery" aria-labelledby="h-gal" style="margin-top:2.5rem">
        <h2 id="h-gal">After-only project gallery</h2>
        <ProjectGallery items={SINGLES} />
      </section>
      <section id="placement" aria-labelledby="h-pl" style="margin-top:2.5rem">
        <h2 id="h-pl">Proposed placement (not live)</h2>
        <ul>
          <li><strong>/portfolio</strong>: drag slider (A) for all 5 pairs, then the after-only gallery.</li>
          <li><strong>/bathroom-remodeling/tub-to-shower-conversions</strong>: Before/After buttons (B) with the tub-to-walk-in-shower pair.</li>
          <li><strong>/bathroom-remodeling/walk-in-showers</strong>: the tub-to-walk-in-shower pair as a slider (A) plus the 3 after-only shower photos.</li>
          <li><strong>/bathroom-remodeling</strong>: stacked (D) with the primary-bath freestanding tub pair and the grab-bar surround pair.</li>
          <li><strong>Homepage (optional)</strong>: one slider (A) with the gray subway tile pair.</li>
        </ul>
      </section>
    </div>
  </main>
  <SiteFooter />
</Layout>
<style>
.demo-grid{display:grid;gap:1.5rem}
@media (min-width:1024px){.demo-grid{grid-template-columns:repeat(2,1fr)}}
</style>
