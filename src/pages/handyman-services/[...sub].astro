---
// Stage 2: handyman-services hub + sub-service pages (AI Studio service layout). City pages stay on the catch-all until stage 3.
import ServicePage from '../../components/service/ServicePage.astro';
import { SERVICE_PAGE_SLUGS } from '../../data/service-pages.mjs';
export function getStaticPaths() {
  return SERVICE_PAGE_SLUGS.filter((s) => s === 'handyman-services' || s.startsWith('handyman-services/')).map((s) => ({ params: { sub: s === 'handyman-services' ? undefined : s.slice('handyman-services/'.length) }, props: { slug: s } }));
}
---
<ServicePage slug={Astro.props.slug} />
